# ─────────────────────────────────────────────────────────────────────────────
# MK Hardware ERP demo — optional configuration.
# The default demo needs NO environment variables and NO secrets.
# Copy to .env.local for local overrides. Never commit real secrets.
# Anything prefixed VITE_ is bundled into public JavaScript — never put secrets in VITE_ vars.
# ─────────────────────────────────────────────────────────────────────────────

# Official logo (ONLY with the client's written permission). Place the file in public/brand/
# and point to it here. Leave empty to use the temporary "MK Hardware / DEMO" wordmark.
VITE_BRAND_LOGO=

# Data backend. "indexeddb" (default) keeps data in the visitor's browser.
# "d1" is a documented future option and is NOT implemented in the demo build
# (see integrations/d1-prototype — requires authentication + server-side authorisation).
VITE_DATA_BACKEND=indexeddb

# Optional map tiles for a future MapLibre delivery map. Requires a licensed / terms-compliant
# provider. Core delivery features work without it (a self-contained schematic is used).
VITE_MAP_STYLE_URL=

# ── Server-side only (future Cloudflare Pages Functions; set in the Cloudflare dashboard) ──
# D1 binding name used by the prototype functions:   DB
# Session / auth secret for a real deployment:         AUTH_SECRET=   (never in VITE_ vars)
# MyInvois / accounting / WhatsApp credentials:        not used by the demo
